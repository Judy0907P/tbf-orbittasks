# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Then load it into your shell before running seed / API commands:
#   set -a && source .env && set +a

PORT=3001
NODE_ENV=development

# Required for signing auth tokens. Any non-empty string works locally.
JWT_SECRET=dev-secret-change-me

# File-backed JSON store (not Postgres). Path is resolved relative to
# apps/api when you run workspace scripts, so this lands at
# apps/api/.data/orbittasks.json.
DATABASE_URL=file:.data/orbittasks.json
