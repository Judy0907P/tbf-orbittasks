# Copy this file to .env:
#   cp .env.example .env
# Or run: bash scripts/setup.sh / make setup

PORT=3001
NODE_ENV=development

# Required. Any random string for local dev; used to sign auth tokens.
JWT_SECRET=replace-me-with-a-random-string-for-local-dev

# Required for persistent local data. File-backed JSON store (not Postgres).
# Under tests this is ignored and the DB stays in-memory.
DATABASE_URL=file:.data/orbittasks.json
